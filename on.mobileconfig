<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <!-- DNS Settings Payload -->
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerAddresses</key>
                <array>
                    <string>1.1.1.1</string>
                    <string>1.0.0.1</string>
                </array>
                <key>ServerURL</key>
                <string>https://dns.appiraq.com/dns-query</string>
            </dict>
            <key>PayloadDescription</key>
            <string>DNS Configuration for appiraq</string>
            <key>PayloadDisplayName</key>
            <string>appiraq</string>
            <key>PayloadIdentifier</key>
            <string>com.appiraq.dnsprofile</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>12345678-ABCD-1234-ABCD-1234567890AB</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
        </dict>

        <!-- Web Clip Payload -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.appiraq.webclip</string>
            <key>PayloadUUID</key>
            <string>11223344-AABB-CCDD-EEFF-112233445566</string>
            <key>PayloadDisplayName</key>
            <string>appiraq</string>
            <key>URL</key>
            <string>https://yourgithubusername.github.io/index.html</string>
            <key>IsRemovable</key>
            <true/>
        </dict>
    </array>

    <!-- Profile Metadata -->
    <key>PayloadDescription</key>
    <string>Configuration profile to set DNS and Web Clip for appiraq</string>
    <key>PayloadDisplayName</key>
    <string>appiraq</string>
    <key>PayloadIdentifier</key>
    <string>com.appiraq.profile</string>
    <key>PayloadOrganization</key>
    <string>ipasoon</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>87654321-DCBA-4321-DCBA-0987654321FE</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
