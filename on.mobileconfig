<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadIdentifier</key>
	<string>com.appiraq.profile</string>
	<key>PayloadUUID</key>
	<string>AAAABBBB-CCCC-DDDD-EEEE-APPIRAQ0001</string>
	<key>PayloadDisplayName</key>
	<string>app-iraq</string>
	<key>PayloadOrganization</key>
	<string>app-iraq</string>

	<key>PayloadContent</key>
	<array>

		<!-- DNS -->
		<dict>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>com.appiraq.dns</string>
			<key>PayloadUUID</key>
			<string>DNS-APP-IRAQ-0001</string>
			<key>PayloadDisplayName</key>
			<string>app-iraq DNS</string>

			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>HTTPS</string>
				<key>ServerURL</key>
				<string>https://32ev95ur21.cloudflare-gateway.com/dns-query</string>
			</dict>
		</dict>

		<!-- WebClip (الأيقونة الحقيقية) -->
		<dict>
			<key>PayloadType</key>
			<string>com.apple.webClip.managed</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>com.appiraq.webclip</string>
			<key>PayloadUUID</key>
			<string>WEB-APP-IRAQ-0001</string>
			<key>PayloadDisplayName</key>
			<string>app-iraq</string>

			<key>Label</key>
			<string>app-iraq</string>
			<key>URL</key>
			<string>https://ipasoon.icu</string>
			<key>IsRemovable</key>
			<true/>
			<key>FullScreen</key>
			<false/>

			<key>Icon</key>
			<data>
			ضع هنا Base64 للصورة بعد تحويلها إلى PNG 180x180
			</data>
		</dict>

	</array>

</dict>
</plist>
